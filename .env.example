# Copy to .env (git-ignored). NEVER commit a real key.
# In production these values come from GCP Secret Manager, not a file.

# Market data : Massive (formerly Polygon.io), free Basic plan. The legacy name POLYGON_API_KEY is still read.
MASSIVE_API_KEY=

# Where the scan goes : trade's API and its scanner token. trade's Tilt sets both when it runs the
# job ; fill them only to run it by hand.
# TRADE_URL=http://localhost:8080
# TRADE_API_TOKEN=

# Run reports (optional) : set both to push them to Telegram, leave empty to log only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
